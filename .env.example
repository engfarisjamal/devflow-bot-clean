# ====== App ======
APP_NAME=devflow-bot
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change_this_to_a_random_secret

# ====== Database ======
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/devflow

# ====== Redis ======
REDIS_URL=redis://localhost:6379/0

# ====== Telegram ======
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_id

# ====== GitHub ======
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_TOKEN=your_github_token

# ====== Sentry ======
SENTRY_DSN=

# ====== Logging ======
LOG_LEVEL=INFO
